<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NppOmniView</AssemblyName>
    <RootNamespace>NppPlugin.OmniView</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 版本号定义与程序集元数据 (符合 Notepad++ 官方开源插件规范) -->
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <InformationalVersion>1.1.2</InformationalVersion>
    <Product>NppOmniView (全能视图)</Product>
    <Title>NppOmniView</Title>
    <Description>现代全格式实时渲染预览与双向就地编辑 Notepad++ 插件 (x64)</Description>
    <Company>NppOmniView Open-Source Project</Company>
    <Authors>NppOmniView Contributors</Authors>
    <Copyright>Copyright © 2026 NppOmniView Contributors. All rights reserved.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wuyanHH/NppOmniView</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wuyanHH/NppOmniView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web"/>
    <Reference Include="System.Web.Extensions"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Xml"/>
    <Reference Include="System.Xml.Linq"/>
    <PackageReference Include="Markdig" Version="0.37.0"/>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45"/>
  </ItemGroup>
</Project>
